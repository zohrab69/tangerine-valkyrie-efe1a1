# OmniRoute settings. 07-setup-omniroute.ps1 creates the real omniroute.env
# with random secrets. Never commit it. Provider API keys are NOT stored here:
# you add them in the OmniRoute dashboard, which encrypts them.
JWT_SECRET=generated
API_KEY_SECRET=generated
STORAGE_ENCRYPTION_KEY=generated
STORAGE_ENCRYPTION_KEY_VERSION=v1
REQUIRE_API_KEY=true
ALLOW_API_KEY_REVEAL=false
NODE_ENV=production
PORT=20128
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128
AUTH_COOKIE_SECURE=false
INSPECTOR_MASK_SECRETS=true
