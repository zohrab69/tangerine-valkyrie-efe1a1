# Compose variables (versions + SearXNG secret). 03-setup-sandbox.ps1 creates
# the real ".env" from this file. Never commit the real file.

# Sandbox API, runner and sandbox images ship as one release. 1.8.1 is the
# version n8n's own installer (get-n8n.sh) currently pins and tests.
N8N_SANDBOX_VERSION=1.8.1

# Path B only. Must be >= the version your current n8n container runs
# (01-inspect.ps1 prints it). Never downgrade an n8n database.
N8N_VERSION=CHANGE-ME

SEARXNG_SECRET=generated-by-setup-script
